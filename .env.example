# =============================================================================
# Logic Metric · variables de entorno
# =============================================================================
# Copie este archivo como `.env.local` y complete los valores reales.
# `.env.local` está en .gitignore: NUNCA suba credenciales al repositorio.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase · obligatorias
# -----------------------------------------------------------------------------
# Panel de Supabase → Project Settings → Data API / API Keys

# URL del proyecto. Viaja al navegador.
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (publishable). Viaja al navegador — es seguro:
# todo lo que puede leer o escribir lo determinan las políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ Clave de servicio. SALTA ROW LEVEL SECURITY POR COMPLETO.
# Sólo en el servidor. Nunca la prefije con NEXT_PUBLIC_ y nunca la comparta.
# La usan exclusivamente: alta y baja de usuarios, cambio de contraseña, cierre
# de sesiones de un usuario suspendido, y el script de primer administrador.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Identificador técnico de autenticación · opcional
# -----------------------------------------------------------------------------
# El usuario inicia sesión con RUT y contraseña; nunca ve ni escribe un correo.
# Supabase Auth exige internamente un email, que se deriva del RUT así:
#
#     11.111.111-1  →  11111111-1@usuarios.interno
#
# Este dominio NO recibe correo: es sólo un espacio de nombres.
# Cámbielo únicamente ANTES de crear el primer usuario: modificarlo después
# dejaría a los usuarios existentes sin poder iniciar sesión.
AUTH_EMAIL_DOMAIN=usuarios.interno


# -----------------------------------------------------------------------------
# Análisis de documentos · NO REQUIERE CONFIGURACIÓN
# -----------------------------------------------------------------------------
# Por defecto el análisis del PDF de rechazo corre EN LOCAL: OCR con Tesseract
# sobre el propio servidor y extracción de motivos por reglas.
#
#   · Gratuito e ilimitado
#   · Sin cuenta ni clave
#   · Funciona sin conexión (el modelo de idioma se descarga una vez, ~8 MB)
#   · Ningún documento sale de la máquina
#
# No hay nada que rellenar aquí para que funcione.
#
# ---- Mejora OPCIONAL y de pago ----------------------------------------------
# El motor local reconoce la ESTRUCTURA del informe, no su significado. Si sus
# informes tienen un formato irregular y quiere más precisión, puede activar un
# proveedor multimodal, que entiende el documento.
#
# Si define esta clave, se usa en lugar del motor local.
# Clave de la API de Anthropic (https://console.anthropic.com). Sólo servidor.
DOCUMENT_AI_API_KEY=

# Modelo multimodal. Sólo aplica si definió la clave de arriba.
DOCUMENT_AI_MODEL=claude-opus-5


# -----------------------------------------------------------------------------
# Pruebas de base de datos · opcional
# -----------------------------------------------------------------------------
# Cadena de conexión que usa `npm run test:db`.
# Por defecto apunta a la base local de `supabase start`.
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
